# ── Secrets — never commit. Real env files stay local; templates go in .env.example ──
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.keystore
id_rsa
id_ed25519
secrets.json
.secrets

# ACLED OAuth token cache (access + refresh tokens) — never commit
.acled_token.json

# Local-only security notes / threat model — never publish
SECURITY_THREAT_MODEL.md
*.local.md

*.pyc
__pycache__/
.pytest_cache/
arke.db
arke.db-wal
arke.db-shm
venv/
arke_env/
node_modules/
.next/
dist/
.DS_Store
*.log
KICKOFF.MD

# Generated full-repo dump — slurps in local-only files (OPERATIONS.local.md,
# .env), so it can contain the VPS IP, SSH targets, and secrets. Never commit.
repo_dump.txt

# Generated provenance traces (the .gitkeep tracks the empty dir; sha256 in the
# DB is the verifiable hash regardless of where the JSON is pinned)
dashboard/public/traces/*
!dashboard/public/traces/.gitkeep

MANUAL_STEPS.MD

TRACTION.MD